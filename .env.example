ANTHROPIC_API_KEY=

# Optional — override default exploit generator model (default: claude-sonnet-4-6)
NICO_EXPLOIT_MODEL=

# Target configuration (can also be passed via CLI flags)
NICO_TARGET_URL=
NICO_SOURCE_PATH=

# Sandbox settings
SANDBOX_TIMEOUT_MS=30000
SANDBOX_MAX_RETRIES=2

